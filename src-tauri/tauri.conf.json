{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Kakehashi",
  "version": "2.24.0",
  "identifier": "com.tvnjp.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Kakehashi · Việt–Nhật",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Kakehashi · Phụ đề",
        "width": 500,
        "height": 700,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "x": 50,
        "y": 50
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/kakehashi/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Kakehashi — Trợ lý cuộc họp Việt–Nhật",
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "ort/*.dll": "./"
    },
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/kakehashi/32x32.png",
      "icons/kakehashi/128x128.png",
      "icons/kakehashi/128x128@2x.png",
      "icons/kakehashi/icon.icns",
      "icons/kakehashi/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/kakehashi/icon.ico",
        "headerImage": "nsis-header.bmp",
        "sidebarImage": "nsis-sidebar.bmp",
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  },
  "plugins": {}
}
